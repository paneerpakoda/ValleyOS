# Valley OS — example environment variables.
#
# Copy this file to `.env` (which is gitignored) and edit as needed.
#
# Heads up: the MVP is offline-first with no backend, no auth, no cloud,
# no analytics, and no AI. SQLite runs on-device and static content ships
# bundled as JSON. So there are almost no env vars to set right now —
# this file mostly exists so future additions have an obvious home.
#
# Conventions
# - Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle
#   at build time and are visible to anyone who unpacks the APK.
#   NEVER put a secret behind an EXPO_PUBLIC_ prefix.
# - Server-only secrets (none today) would go without the prefix.


# ─── Runtime ──────────────────────────────────────────────────────────

# App environment. "development" enables debug screens, seed-data buttons,
# and verbose logging. "production" disables them.
# Values: development | production
EXPO_PUBLIC_APP_ENV=development

# Log level for the in-app logger.
# Values: debug | info | warn | error
EXPO_PUBLIC_LOG_LEVEL=debug


# ─── EAS Build (CI only — not needed for local `eas build`) ───────────

# Expo personal access token for non-interactive auth from CI.
# Generate at: https://expo.dev/accounts/<account>/settings/access-tokens
# Leave blank for local development.
# EXPO_TOKEN=
